<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件的布局(RemoteViews 支持的范围很窄:线性布局 + TextView/ImageView/Button,
     **不能用 ConstraintLayout、不能写自定义 View**)。

     配色刻意写死成品牌深蓝底 + 浅色字:桌面背景可能是任意壁纸/浅色或深色主题,
     只有自带底色的卡片在两种情况下都清楚 —— 这也是小组件不该跟 App 内深色模式
     联动的原因(用户在系统浅色下也可能用深色壁纸)。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="8dp"
    android:background="@drawable/readflow_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_label"
            android:textColor="@color/widget_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_accent"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="1/3"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_headline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingTop="6dp"
        android:textColor="@color/widget_text_primary"
        android:textSize="17sp"
        android:textStyle="bold"
        tools:text="复习 32 个词 等 2 项" />

    <TextView
        android:id="@+id/widget_due"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp"
        tools:text="待复习 32 个 · 新词额度 10" />

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="2dp"
        android:textColor="@color/widget_text_muted"
        android:textSize="10sp"
        tools:text="连续 5 天 · 更新于 08:12" />
</LinearLayout>
