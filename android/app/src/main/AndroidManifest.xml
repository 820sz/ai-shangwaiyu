<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- 自动更新:允许请求安装应用。缺此权限时系统安装器对 App 发起的
         安装静默拒绝——不弹界面不报错(手动装 APK 走文件管理器,不受影响,
         这就是 App 内更新一直"没反应"的终极根因) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- 关备份(v1.9.0 审查 P2-8):默认 allowBackup=true 会把 Hive 里的
         明文 API Key 与学习数据随系统云备份/换机迁移传出本机。
         fullBackupContent="false" 是同一意图的显式化(老系统只认它,
         新系统的 dataExtractionRules 也由此归零)——别只删这一行。
         代价:换机不能靠系统备份恢复(数据都在本机,重装即全新)。 -->
    <!-- 已删除 android:usesCleartextTraffic="true"(v1.9.0 审查 P2-7):
         api_endpoint.normalizedBaseUrl 把用户存的 http:// 强制归一为 https://,
         全库无 http:// 端点、无 localhost/内网地址,这个全局开关收益为零,
         只扩大明文可被中间人篡改的面。内网自建端点请改用 networkSecurityConfig
         按域名白名单放行(不要恢复全局开关)。 -->
    <application
        android:label="AI上外语"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 桌面小组件点击后拉起本 Activity 用的 action(home_widget 的
                 HomeWidgetLaunchIntent 会带上这个 action;显式组件 + 这个 filter
                 两条路都能到,缺了它在部分机型上点击无反应) -->
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.LAUNCH" />
            </intent-filter>
        </activity>
        <!-- 桌面小组件(v2.2):AppWidgetProvider 必须显式声明,否则启动器的
             "添加小组件"列表里看不到它。exported=true 是 home_widget 官方示例
             的写法(AppWidget 的更新广播由系统派发);暴露的后果只是"别人能触发
             我们重绘一次" —— provider 里只读自己写的 SharedPreferences,无副作用 -->
        <receiver
            android:name=".ReadFlowWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/readflow_widget_info" />
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- 裁剪图片:uCrop 界面(image_cropper 官方要求手动声明,缺失则点击裁剪闪退) -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Ucrop.CropTheme"/>
        <!-- 自动更新:FileProvider 提供给系统安装器读取下载的 APK。
             authority 必须与 open_filex 4.7.0 硬编码的
             packageName + ".fileProvider.com.crazecoder.openfile" 完全一致——
             不一致时 getUriForFile 抛异常被插件吞掉,安装器静默不拉起 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileProvider.com.crazecoder.openfile"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- 自动更新:查询系统 APK 安装器 -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="application/vnd.android.package-archive"/>
        </intent>
    </queries>
</manifest>
